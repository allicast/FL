--- !u!114 &398036572
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 398036571}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3a791eb406d4034c810825b6790a34a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  leftNameText: {fileID: 1884606021}
  rightNameText: {fileID: 73532409}
  dialogText: {fileID: 1695624201}
  leftCharacterImage: {fileID: 1764146533}
  rightCharacterImage: {fileID: 734289224}
  leftFrameImage: {fileID: 58933577}
  rightFrameImage: {fileID: 325553183}
  nextButtonLeft: {fileID: 2072146786}
  nextButtonRight: {fileID: 1352605198}
  typeSpeed: 0.04
  lines:
  - characterName: ???
    text: ...
    characterSprite: {fileID: 21300000, guid: 84888e4b7862a5849938216e72a85046, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: ???
    text: "Faver? Hey peque\xF1a?"
    characterSprite: {fileID: 21300000, guid: 84888e4b7862a5849938216e72a85046, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: Faver
    text: AAHH!!
    characterSprite: {fileID: 21300000, guid: 24e934fa4d797e946aaf2409614bff2d, type: 3}
    frameSprite: {fileID: 21300000, guid: cd953e0af28769544a84f6b80f0da5d7, type: 3}
    side: 1
  - characterName: ???
    text: "Ey, ey\u2026 tranquila ni\xF1a. Ya despertaste. Solo fue un sue\xF1o."
    characterSprite: {fileID: 21300000, guid: 11368f54509baa9409661adc38360bd6, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: Faver
    text: Alex...Hermanito!!
    characterSprite: {fileID: 21300000, guid: 0823bc1555d9c1349a1c607cc4c0b694, type: 3}
    frameSprite: {fileID: 21300000, guid: cd953e0af28769544a84f6b80f0da5d7, type: 3}
    side: 1
  - characterName: Alex
    text: ...Otra pesadilla?
    characterSprite: {fileID: 21300000, guid: 3ca0fab4f7f112e419c107425a52bc12, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: Faver
    text: "Se sent\xEDa tan real\u2026 Hab\xEDa sombras\u2026 y voces\u2026"
    characterSprite: {fileID: 21300000, guid: 0823bc1555d9c1349a1c607cc4c0b694, type: 3}
    frameSprite: {fileID: 21300000, guid: cd953e0af28769544a84f6b80f0da5d7, type: 3}
    side: 1
  - characterName: Alex
    text: "Lo s\xE9 peque\xF1a. Te escuch\xE9 desde el pasillo. Pero m\xEDrame, ya
      pas\xF3. Est\xE1s aqu\xED, en tu cuarto, conmigo."
    characterSprite: {fileID: 21300000, guid: e539702e5355c974ea391802ab083324, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: Faver
    text: "Escuch\xE9 ruidos\u2026 gritos\u2026 y despu\xE9s, pap\xE1\u2026 no recuerdo
      bien\u2026 todo se volvi\xF3 oscuro."
    characterSprite: {fileID: 21300000, guid: 24e934fa4d797e946aaf2409614bff2d, type: 3}
    frameSprite: {fileID: 21300000, guid: cd953e0af28769544a84f6b80f0da5d7, type: 3}
    side: 1
  - characterName: Alex
    text: "Shh\u2026 respira conmigo."
    characterSprite: {fileID: 21300000, guid: 11368f54509baa9409661adc38360bd6, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: Alex
    text: "No fue real, Faver. Fue solo una pesadilla. Pap\xE1 est\xE1 bien."
    characterSprite: {fileID: 21300000, guid: e539702e5355c974ea391802ab083324, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: Faver
    text: P-pero... realmente siento como si muriera...
    characterSprite: {fileID: 21300000, guid: 8d913fb57fc031646b8ee3d122224184, type: 3}
    frameSprite: {fileID: 21300000, guid: cd953e0af28769544a84f6b80f0da5d7, type: 3}
    side: 1
  - characterName: Alex
    text: Las pesadillas hacen eso.
    characterSprite: {fileID: 21300000, guid: 84888e4b7862a5849938216e72a85046, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: Alex
    text: "Anda, lev\xE1ntate. Pap\xE1 nos necesita abajo en el sal\xF3n principal."
    characterSprite: {fileID: 21300000, guid: 3ca0fab4f7f112e419c107425a52bc12, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: Faver
    text: "\xBFPap\xE1? \xBFPas\xF3 algo?"
    characterSprite: {fileID: 21300000, guid: f4951c1105a4d8446b1faa412085063e, type: 3}
    frameSprite: {fileID: 21300000, guid: cd953e0af28769544a84f6b80f0da5d7, type: 3}
    side: 1
  - characterName: Alex
    text: "No lo s\xE9, pero dijo que era importante."
    characterSprite: {fileID: 21300000, guid: 11368f54509baa9409661adc38360bd6, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: Alex
    text: "Y\u2026 antes de que bajes\u2026 quiz\xE1 deber\xEDas ordenar un poco
      tu cuarto.\nYa sabes c\xF3mo se pone si ve todo tirado por ah\xED."
    characterSprite: {fileID: 21300000, guid: 3ca0fab4f7f112e419c107425a52bc12, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: Faver
    text: "Ugh\u2026 bien\u2026 ya voy a organizar."
    characterSprite: {fileID: 21300000, guid: 1a48a1c4d68358a408de38f3230c0d02, type: 3}
    frameSprite: {fileID: 21300000, guid: cd953e0af28769544a84f6b80f0da5d7, type: 3}
    side: 1
  - characterName: Alex
    text: Te espero abajo.
    characterSprite: {fileID: 21300000, guid: 11368f54509baa9409661adc38360bd6, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: Alex
    text: "No tardes, \xBFs\xED?"
    characterSprite: {fileID: 21300000, guid: a9c69fa78d035ec4cab5fa91d4051ab2, type: 3}
    frameSprite: {fileID: 21300000, guid: 59557f8523f08c1409039e7c0e06e6c6, type: 3}
    side: 0
  - characterName: Faver
    text: Prometido.
    characterSprite: {fileID: 21300000, guid: 91d71aae9021fad4fa6ce8aac3a99a7a, type: 3}
    frameSprite: {fileID: 21300000, guid: cd953e0af28769544a84f6b80f0da5d7, type: 3}
    side: 1
