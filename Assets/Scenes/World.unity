  m_Script: {fileID: 11500000, guid: cf35c8a97382ecf489762fa22badf92a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  objectName: Lamp
  objectImage: {fileID: 21300000, guid: bf2625e721deac94e91dd939d96c2b32, type: 3}
  objectDescription: "Alex me regal\xF3 esta l\xE1mpara sab\xEDa que le tengo miedo
    a la oscuridad. Dijo que su luz me cuidar\xEDa cuando todo estuviera oscuro;
    Su luz brilla como si estuviera viva. A veces creo que me mira, porque cuando
    paso cerca, su luz se hace m\xE1s fuerte\u2026 como si estuviera contenta de
    verme. Aunque Alex dice que solo es una l\xE1mpara\u2026 yo s\xE9 que no. Ella
    me cuida de verdad."
  useText: "Aqu\xED ya hay luz\u2026no hace falta usarla por ahora."
