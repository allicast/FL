  m_Name: 
  m_EditorClassIdentifier: 
  objectName: Train
  objectImage: {fileID: 21300000, guid: 9dd79409ed04ebc4ea39c13ed65594ec, type: 3}
  objectDescription: "Este es mi trencito favorito y es el unico. Tiene rueditas
    que ya no giran tan r\xE1pido, pero cuando lo empujo hace un clic... eso es cool,
    cuando me duermo en las noches lo escucho moverse por si  solo; cuando Alex me
    lo regalo me dijo que los trenes nunca se detienen de verdad, solo descansan
    hasta el pr\xF3ximo viaje."
  useText: "No puedo jugar ahora\u2026 primero tengo que ordenar mi cuarto. Tal vez
    despu\xE9s..."
  isFocused: 0
