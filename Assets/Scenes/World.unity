  m_Script: {fileID: 11500000, guid: cf35c8a97382ecf489762fa22badf92a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  objectName: Doll
  objectImage: {fileID: 21300000, guid: d96895a03a3e22542bf00ebfc6217d71, type: 3}
  objectDescription: "Karly... \xA1mi mu\xF1eca favorita!\nAl fin te encontr\xE9\u2026
    \xBFd\xF3nde estuviste? Pens\xE9 que Papi te hab\xEDa desechado. A veces me dice
    que deber\xEDa tirarla, pero no puedo. Ella me habla cuando nadie m\xE1s lo hace.
    A veces susurra mi nombre\u2026 y me canta la misma canci\xF3n que mam\xE1 sol\xEDa
    cantarme."
  useText: "Lo siento\u2026 no puedo jugar contigo ahora, Si te dejo en tu sitio,
    mi habitaci\xF3n se ver\xE1 m\xE1s ordenada."
