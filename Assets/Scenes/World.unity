  m_Script: {fileID: 11500000, guid: cf35c8a97382ecf489762fa22badf92a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  objectName: Teddy Bear
  objectImage: {fileID: 21300000, guid: e5f708c5ef1e1724eaf84894a3842ec5, type: 3}
  objectDescription: "Mi osito con engranajes oxidados... sus ojos me asustan; parecen
    seguirme en la oscuridad. Aun as\xED, me gusta abrazarlo cada noche antes de
    dormir. Lo tengo desde antes de que papi Ares me adoptara. No recuerdo qui\xE9n
    me lo obsequi\xF3... pero es mi mejor amigo. As\xED que... gracias, quien sea
    que me lo dio."
  useText: "No aqu\xED\u2026Deber\xEDa ponerte en otro lugar\u2026 tengo que organizar
    mi habitaci\xF3n r\xE1pido."
  isFocused: 0
